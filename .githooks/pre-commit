#!/usr/bin/env sh
set -e

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-no-bom.ps1
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-no-bom.ps1
elif command -v bash >/dev/null 2>&1; then
  bash ./scripts/check-no-bom.sh
else
  echo "No supported shell found to run BOM check." >&2
  exit 2
fi
